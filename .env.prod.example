# cp .env.prod.example .env 후 값을 채운다 (.env는 git 제외)
#   로컬 확인: DOMAIN=localhost, PUBLIC_IP=127.0.0.1, PRIVATE_IP=127.0.0.1
#   서버:     실제 도메인, Lightsail Static IP, 사설 IP(hostname -I)
# 비밀값 생성: openssl rand -hex 32   (JWT_SECRET만: openssl rand -base64 32)

DOMAIN=            # 예: meet.example.com
PUBLIC_IP=         # Lightsail Static IP
PRIVATE_IP=        # Lightsail 사설 IP (서버에서 hostname -I)

DB_USERNAME=ocsmeet
DB_PASSWORD=
DB_ROOT_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
RTC_TURN_SECRET=
